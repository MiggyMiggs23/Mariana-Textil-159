    "identity": "SELECT current_database() AS database_name,\n    (SELECT oid FROM pg_database WHERE datname=current_database()) AS database_oid,\n    current_schema() AS schema_name, current_user AS database_role,\n    current_setting('server_version') AS server_version,\n    inet_server_addr() AS server_address, inet_server_port() AS server_port,\n    pg_backend_pid() AS backend_pid, pg_postmaster_start_time()::text AS server_started_at,\n    current_setting('transaction_read_only') AS transaction_read_only,\n    clock_timestamp()::text AS observed_at",
    "inventory": "SELECT\n    (SELECT count(*)::int FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace\n      WHERE n.nspname='public' AND c.relkind='r') AS public_tables,\n    (SELECT count(*)::int FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid\n      JOIN pg_namespace n ON n.oid=c.relnamespace\n      WHERE n.nspname='public' AND NOT t.tgisinternal) AS noninternal_triggers,\n    (SELECT count(*)::int FROM public.movimientos_credito) AS credit_movements,\n    (SELECT pg_total_relation_size('public.movimientos_credito')) AS credit_bytes,\n    (SELECT count(*)::int FROM pg_event_trigger WHERE evtenabled <> 'D') AS active_event_triggers,\n    (SELECT jsonb_agg(c.relname ORDER BY c.relname) FROM pg_class c\n      JOIN pg_namespace n ON n.oid=c.relnamespace\n      WHERE n.nspname='public' AND c.relkind='r') AS tables,\n    (SELECT jsonb_agg(jsonb_build_object('table', c.relname, 'trigger', t.tgname)\n      ORDER BY c.relname,t.tgname) FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid\n      JOIN pg_namespace n ON n.oid=c.relnamespace\n      WHERE n.nspname='public' AND NOT t.tgisinternal) AS triggers"
  },
