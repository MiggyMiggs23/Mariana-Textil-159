    {
      "kind": "function",
      "schema_name": "public",
      "object_name": "e1_guard_cash_capture_closed",
      "parent_name": "",
      "definition": "CREATE OR REPLACE FUNCTION public.e1_guard_cash_capture_closed()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_catalog', 'public'\nAS $function$\nBEGIN\n  IF NEW.forma_pago::text='EFECTIVO'\n    AND NEW.naturaleza::text IN ('INGRESO_FISICO','DEVOLUCION_FISICA')\n    AND NOT COALESCE((NEW.naturaleza::text='INGRESO_FISICO' AND NEW.tipo::text='ABONO'\n      AND NEW.operacion_productor='ABONO_ORDINARIO'),false) THEN\n    RAISE EXCEPTION USING ERRCODE='E1C01',\n      MESSAGE='E1: captura física fuera del abono ordinario E3 permanece cerrada.';\n  END IF;\n  RETURN NEW;\nEND;\n$function$\n"
    },
    {
      "kind": "function",
      "schema_name": "public",
      "object_name": "e3_receipt_immutable",
      "parent_name": "",
      "definition": "CREATE OR REPLACE FUNCTION public.e3_receipt_immutable()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN RAISE EXCEPTION 'E3: evidencia inmutable; no editar, borrar ni truncar'; END $function$\n"
    },
