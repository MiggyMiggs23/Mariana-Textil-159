{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:inventario": "tsx src/lib/inventario.test.ts",
    "test:transferencias-block3": "tsx --test src/transferencias-block3-architecture.test.ts",
    "test:entradas": "tsx src/lib/entradas.test.ts",
    "test:proveedores": "tsx src/lib/compras-proveedor.test.ts",
    "test:pos": "tsx src/lib/pos.test.ts",
    "test:clientes-aging": "tsx --test src/lib/clientes-aging.test.ts",
    "test:clientes-ledger": "tsx --test src/lib/clientes-ledger.test.ts",
    "test:clientes-create": "tsx --test src/lib/clientes-create.test.ts",
    "test:ticket-iva-schema": "tsx src/lib/ticket-iva-schema.test.ts",
    "test:ticket-line-types-schema": "NODE_ENV=test tsx --test src/lib/ticket-line-types-schema.test.ts",
    "test:pending-costs-schema": "NODE_ENV=test tsx --test src/lib/pending-costs-schema.test.ts",
    "test:salidas-schema": "tsx src/lib/salidas-schema.test.ts",
    "test:salidas": "tsx src/lib/salidas.test.ts",
    "test:salidas-api": "tsx --test src/salidas-api.test.ts",
    "test:scanned-code-contract": "tsx --test src/scanned-code.contract.test.ts",
    "test:kardex-api": "NODE_ENV=test tsx --test src/kardex-api.test.ts",
    "test:admin-bypass-empty": "tsx src/admin-bypass-empty-permissions.test.ts",
    "test:security-api": "tsx src/security-api.test.ts",
    "test:supervisor-integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:?TEST_DATABASE_URL must be explicit} NODE_ENV=test tsx src/security-api.test.ts",
    "test:clientes-ajustes": "tsx --test src/clientes-ajustes-api.test.ts",
    "test:clientes-ajustes:unit": "tsx --test src/lib/spanish-order.test.ts",
    "test:admin-analytics": "tsx --test src/lib/admin-analytics.contract.ts",
    "test:admin-analytics-integration": "tsx --test src/admin-analytics.integration.test.ts",
    "test:admin-alertas-integration": "NODE_ENV=test tsx --test src/admin-alertas.integration.test.ts",
    "test:etiquetas": "NODE_ENV=test tsx --test src/etiquetas-api.test.ts",
    "test:etiquetas-integration": "NODE_ENV=test tsx --test src/etiquetas-api.integration.test.ts"
    ,"test:reportes": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://reportes-test-guard@localhost/reportes_test} tsx --test src/lib/reportes.test.ts",
    "test:reportes-integration": "tsx --test src/reportes.integration.test.ts",
    "test:contenedores": "NODE_ENV=test tsx --test src/lib/contenedores.test.ts",
    "test:contenedores-integration": "NODE_ENV=test tsx --test src/contenedores.integration.test.ts",
    "test:precios": "tsx --test src/lib/precios.test.ts",
    "test:precios-integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:?TEST_DATABASE_URL must be explicit} NODE_ENV=test tsx --test src/precios.integration.test.ts",
    "test:productos-cache-integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:?TEST_DATABASE_URL must be explicit} NODE_ENV=test tsx --test src/productos-cache.integration.test.ts",
    "test:inventory-six-view-integration": "test \"${NODE_ENV:?NODE_ENV must be test}\" = test && TEST_DATABASE_URL=${TEST_DATABASE_URL:?TEST_DATABASE_URL must be explicit} NODE_ENV=test tsx --test src/inventory-six-view.integration.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.0.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/number-format": "workspace:*",
    "@workspace/scanned-code": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
